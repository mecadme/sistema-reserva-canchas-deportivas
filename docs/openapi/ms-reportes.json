                    "cancha": {
                        "type": "string"
                    },
                    "reservasOcupadas": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "bloquesDisponibles": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "porcentajeOcupacion": {
                        "type": "number",
                        "format": "double"
                    }
                }
            },
            "ReporteResponse": {
                "type": "object",
                "properties": {
                    "desde": {
                        "type": "string",
                        "format": "date"
                    },
                    "hasta": {
                        "type": "string",
                        "format": "date"
                    },
                    "totalReservas": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "confirmadas": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "canceladas": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "finalizadas": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "ocupacionPorCancha": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OcupacionCancha"
                        }
                    },
                    "reservasPorDeporte": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "integer",
                            "format": "int64"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "name": "bearerAuth",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
