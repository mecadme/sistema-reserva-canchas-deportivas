{
    "openapi": "3.1.0",
    "info": {
        "title": "API de Reportes",
        "version": "v1"
    },
    "servers": [
        {
            "url": "http://localhost:8084",
            "description": "Generated server url"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
